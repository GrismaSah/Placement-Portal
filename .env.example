# =============================================================================
# JAIN Placement Portal — environment template
# =============================================================================
# Copy to backend/.env for local development.
#
# NEVER commit a real .env. One was committed in this repo's history once
# already, which is why the Atlas credentials had to be rotated.
# =============================================================================

# ---- Database ---------------------------------------------------------------
# Atlas connection string. The database name (JAIN_PLACEMENT) is set in code,
# so it does not need to appear here.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# ---- Auth -------------------------------------------------------------------
# Use a long random value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET_KEY=replace-me-with-a-long-random-string
JWT_EXPIRE=7d
COOKIE_EXPIRE=7

# ---- Runtime ----------------------------------------------------------------
# Controls the `secure` flag on the auth cookie — keep this `development` for
# local HTTP use.
NODE_ENV=development
PORT=4000

# Used for local CORS and for links in outgoing email.
FRONTEND_URL=http://localhost:5173

# ---- Email (optional) -------------------------------------------------------
# Without these the app still runs: verification codes are written to the
# server log instead of being emailed. Gmail requires an App Password, not
# your account password.
NODEMAIL_EMAIL=
NODEMAIL_PASSWORD=
SUPPORT_EMAIL=placements@jainuniversity.ac.in
