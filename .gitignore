logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------------------------------------------------------------------------
# Runtime / temporary
# express-fileupload stages resume uploads on disk before the GridFS write.
# ---------------------------------------------------------------------------
tmp/
temp/
uploads/
*.pid
*.seed
*.pid.lock

# ---------------------------------------------------------------------------
# Editors and IDEs
