PORT=4000
FRONTEND_URL=http://localhost:5173

MONGO_URI=your_key

JWT_SECRET_KEY=your_key
JWT_EXPIRE=7d
COOKIE_EXPIRE=7

# Needed only for the student "Apply to job" resume upload.
# Paste your real values here and restart the backend.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_key
CLOUDINARY_API_SECRET=your_key

# Gmail SMTP for verification-code emails. Left blank on purpose:
# send failures are caught and logged, so nothing crashes.
NODEMAIL_EMAIL=
NODEMAIL_PASSWORD=